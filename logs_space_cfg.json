://raw.githubusercontent.com/gradio-app/gradio/main/test/test_files/bus.png","meta":{"_type":"gradio.FileData"},"orig_name":"bus.png","url":"https://raw.githubusercontent.com/gradio-app/gradio/main/test/test_files/bus.png"}},{"id":8,"type":"textbox","props":{"type":"text","lines":1,"label":"Custom instruction (optional) — same scene, your words; custom runs are UNCHECKED (success checker belongs to the original task)","show_label":true,"container":true,"min_width":160,"visible":true,"autofocus":false,"autoscroll":true,"elem_classes":[],"preserved_by_key":["value"],"rtl":false,"buttons":[],"submit_btn":false,"stop_btn":false,"name":"textbox","_selectable":false},"skip_api":false,"component_class_id":"0ad8e7dd48970890cef0fb44101b5b9b5a57422fa28062cfa5b0de927e78f3dc","key":null,"api_info":{"type":"string"},"api_info_as_input":{"type":"string"},"api_info_as_output":{"type":"string"},"example_inputs":"Hello!!"},{"id":9,"type":"checkboxgroup","props":{"choices":[["Action path","Action path"],["Action bars","Action bars"],["Replan timeline","Replan timeline"],["Denoising steps","Denoising steps"],["Grounding heatmap","Grounding heatmap"]],"value":[],"type":"value","label":"X-Ray overlays (opt-in) — drawn into the episode","show_label":true,"show_select_all":false,"container":true,"min_width":160,"visible":true,"elem_classes":[],"preserved_by_key":["value"],"buttons":[],"name":"checkboxgroup","_selectable":false},"skip_api":false,"component_class_id":"f45cf5e306de16bad4316c4c7cc7cad34108f1779e11fec5ba342aff99d86c44","key":null,"api_info":{"items":{"enum":["Action path","Action bars","Replan timeline","Denoising steps","Grounding heatmap"],"type":"string"},"title":"Checkbox Group","type":"array"},"api_info_as_input":{"items":{"enum":["Action path","Action bars","Replan timeline","Denoising steps","Grounding heatmap"],"type":"string"},"title":"Checkbox Group","type":"array"},"api_info_as_output":{"items":{"enum":["Action path","Action bars","Replan timeline","Denoising steps","Grounding heatmap"],"type":"string"},"title":"Checkbox Group","type":"array"},"example_inputs":["Action path"]},{"id":10,"type":"accordion","props":{"label":"What is X-Ray? (read me first)","open":false,"visible":true,"elem_classes":[],"preserved_by_key":[],"name":"accordion"},"skip_api":true,"component_class_id":"f7ca9b901f75c307c1f5ddd33f789d906d98b7f72e2885efbfaa76243b6822af","key":null},{"id":11,"type":"markdown","props":{"value":"This demo runs a **vision-language-action model in closed loop**. The loop, plain and simple: look at the scene → imagine the next 50 actions → execute only the first 5 → look again. X-Ray draws that hidden machinery onto the video so you can watch the model think.\n\n**How to read each overlay:**\n\n- **Action path** — the line of dots is where the model's *imagined* 50-step plan would take the gripper. Only the first fifth (blue, up to the fade) is ever executed; the rest is imagination under uncertainty, and it can leave the frame — that's real, not a bug. Watch how the path changes every replan: that's closed-loop correction.\n- **Action bars** — the raw 7 numbers the robot executes right now: 3 for position, 3 for rotation, 1 for the gripper (green/red = direction). This is the model's entire output, no abstraction.\n- **Replan timeline** — one tick per \"look again\" moment; height = how long inference took, orange = the chunk executing now. Makes the loop's rhythm visible.\n- **Denoising steps** — the model is a *flow-matching* policy: each plan starts as random noise and is refined over 10 steps. The magenta lines show the plan converging from noise (faint) to final (solid). It shows how the trajectory was refined — not what the model 'intends'.\n- **Grounding heatmap** — which image patches the instruction's words pay attention to (orange = more). It should light up on the objects named in the task. Careful: attention weights show *where the model attends*, not *why it acted* — they're a hint, not an explanation.\n\n*All overlays are read-only observations of the model — verified not to change its actions (bitwise-equivalence tested). They add a small amount of GPU time per replan.*","show_label":false,"rtl":false,"latex_delimiters":[{"left":"$$","right":"$$","display":true}],"visible":true,"elem_classes":[],"preserved_by_key":["value"],"sanitize_html":true,"line_breaks":false,"header_links":false,"container":false,"padding":false,"name":"markdown","_selectable":false},"skip_api":false,"component_class_id":"927e99ba5dda4bcd0dfe596d4d0cecdc2e0b41e7e95071a05f96ae3971390ed6","key":null,"api_info":{"type":"string"},"api_info_as_input":{"type":"string"},"api_info_as_output":{"type":"string"},"example_inputs":"# Hello!"},{"id":12,"type":"markdown","props":{"value":"idle — submit a job","show_label":false,"rtl":false,"latex_delimiters":[{"left":"$$","right":"$$","display":true}],"visible":true,"elem_classes":[],"preserved_by_key":["value"],"sanitize_html":true,"line_breaks":false,"header_links":false,"container":false,"padding":false,"name":"markdown","_selectable":false},"skip_api":false,"component_class_id":"927e99ba5dda4bcd0dfe596d4d0cecdc2e0b41e7e95071a05f96ae3971390ed6","key":null,"api_info":{"type":"string"},"api_info_as_input":{"type":"string"},"api_info_as_output":{"type":"string"},"example_inputs":"# Hello!"},{"id":13,"type":"row","props":{"variant":"default","visible":true,"elem_classes":[],"equal_height":false,"show_progress":false,"preserved_by_key":[],"name":"row"},"skip_api":true,"component_class_id":"724216f2707d8e99d1bf5993a957b41df582b9f858086784b9e93dca5b08e3ce","key":null},{"id":14,"type":"image","props":{"streamable":false,"format":"webp","image_mode":"RGB","sources":["upload","webcam","clipboard"],"type":"numpy","label":"latest frame","show_label":true,"buttons":["download","share","fullscreen"],"container":true,"min_width":160,"interactive":false,"visible":true,"streaming":false,"elem_id":"webvla-live","elem_classes":[],"preserved_by_key":["value"],"webcam_options":{"mir